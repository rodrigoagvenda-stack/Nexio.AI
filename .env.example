# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Criptografia (gerar: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Cron
CRON_SECRET=your_cron_secret_here

# OpenAI (plataforma — usado nos agentes)
OPENAI_API_KEY=your_openai_api_key_here

# UAZapi Admin (token administrativo da plataforma)
UAZAPI_ADMIN_TOKEN=your_uazapi_admin_token_here
UAZAPI_BASE_URL=https://nexioai.uazapi.com

# Webhooks uazapi (gerar com: openssl rand -hex 32)
NEXIO_WEBHOOK_SECRET=your_webhook_secret_here

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCALE=price_...

# Google OAuth (um projeto para toda a plataforma)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# N8N
N8N_WEBHOOK_WHATSAPP=https://seu-n8n.com/webhook/nexio-uazapi
